# 경로 API 설정 (실제 값은 .env 에만 — 레포 커밋 금지)
NETWORK_PATH=data/network_anyang.gpickle
NETWORK_VERSION=anyang-osm-2026Q3
REGION_NAME=안양시

# POI 백엔드: db | file | none
POI_BACKEND=file
POI_DATA_DIR=data/poi
# POI_DB_DSN=postgresql+psycopg2://<user>:<pw>@<host>:<port>/<db>

# 서비스
ROUTE_API_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:18000,http://localhost:18000
SNAP_MAX_DIST_M=300
OFF_ROUTE_THRESHOLD_M=30
